  "estimator": {
    "D2_edge": "mean over available mirrored intra-hemispheric edges e of (w_L1[e] - w_R1[e]) * (w_L2[e] - w_R2[e]); halves 1 and 2 are independent epoch sets, so the expectation is the squared true difference without a noise term",
    "D2_node": "mean over kept nodes of (s_L1 - s_R1) * (s_L2 - s_R2) with s = node strength",
    "D2_<summary>": "(m_L1 - m_R1) * (m_L2 - m_R2) for each network summary m",
    "averaging": "each quantity is averaged over the 10 splits",
    "sign": "D2 can be negative (no true asymmetry plus noise); values are not truncated",
    "frame": "D2 is frame-invariant: (I1 - C1)(I2 - C2) = (L1 - R1)(L2 - R2) because the lesion flip changes the sign of both factors. It is reported once and is valid for both the L/R frame (all 45) and the I/C frame (38). Frame-dependent information is carried by the signed cross-half differences.",
    "signed_<summary>_LR": "mean over splits of (d1 + d2)/2 with d = m_L - m_R (raw), all subjects",
    "signed_<summary>_IC": "the same in the ipsilesional-minus-contralesional frame (= signed LR for left lesions, -signed LR for right lesions); NaN for uncertain side",
    "naive_noiseinflated_*": "full-data squared differences ((L - R)^2 averaged as above), which include the estimation-noise variance; descriptive comparison only"
  },
  "splits": {
    "n_splits": 10,
    "seed_base": 2000,
    "seed_rule": "one numpy default_rng per subject, seed = 2000 + zero-based Figshare subject index (sub-01 -> 2000); the 10 splits are drawn sequentially from it",
    "rule": "Split the clean 4 s EPOCHS (not segments: the two 2 s segments of one epoch are correlated) into two halves stratified by class: within each class the epochs are shuffled, the first floor(n/2) go to half 1 and the next floor(n/2) to half 2 (one epoch is left out of that split when n is odd), so both halves have equal size and class composition. Each half is then segmented into 2 s segments and its connectivity recomputed."
  },
  "mask_rule": "The symmetric mask (pairs kept, mirrored edges available) is computed once from the full-data connectivity and applied identically to both halves and both hemispheres.",
  "network_summary_rule": "Computed on RAW clipped masked weights (no ratio normalization, no shared scaling): mean_weight = mean available intra-hemispheric edge weight; mean_strength = mean node strength over kept nodes; glob_eff = weighted global efficiency with lengths 1/w; mean_clust = mean Onnela clustering on raw weights.",
  "label_note": "naive_noiseinflated_* columns and the Step 7 unsigned summaries are noise-inflated, descriptive only",
